{
  "name": "Pix replication review App",
  "env": {
    "REVIEW_APP": {
      "description": "Indicates that the application is a review app",
      "value": "true"
    }
  },
  "addons": [
    {
      "plan": "postgresql:postgresql-sandbox",
      "options": {
        "version": "16.6"
      }
    },
    {
      "plan": "redis:redis-sandbox",
      "options": {
        "version": "7.2.5"
      }
    }
  ],
  "formation": {
    "web": {
      "amount": 0,
      "size": "S"
    },
    "background": {
      "amount": 1,
      "size": "S"
    }
  }
}
